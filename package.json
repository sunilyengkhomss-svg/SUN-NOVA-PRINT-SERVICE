{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "node scripts/sync-wrangler-bindings.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cf:setup": "node scripts/setup-cloudflare-worker.mjs",
    "cf:ci-resolve": "node scripts/resolve-ci-bindings.mjs",
    "cf:validate": "node scripts/validate-wrangler.mjs",
    "cf:sync-secrets": "node scripts/sync-worker-secrets.mjs",
    "cf:deploy": "node scripts/deploy-worker.mjs",
    "cf:check-builds": "node scripts/check-workers-builds.mjs",
    "cf:disconnect-builds": "node scripts/check-workers-builds.mjs --disconnect",
    "deploy:worker": "node scripts/deploy-worker.mjs --build",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name=sun-nova-print-service",
    "db:migrate:remote": "npx wrangler d1 migrations apply sun-nova-db --remote"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@imgly/background-removal": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  }
}
