# GEMINI_API_KEY: Required for Gemini OCR and Resume Assist calls.
# Configure as a Worker Runtime Secret (`npm run cf:sync-secrets` or Cloudflare Dashboard -> Variables and Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Website URL & Vite Base Path (build-time; leave empty until domain is finalized)
APP_URL=""
VITE_SITE_URL=""
VITE_BASE_URL="/"

# Worker Runtime Secrets (push via `npm run cf:sync-secrets` or Workers -> Variables and Secrets; NOT Build Variables)
ADMIN_SETUP_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="SUN-NOVA PRINT SERVICE <onboarding@resend.dev>"

# Cloudflare Workers Build Variables (used by `npm run build` before `npx wrangler deploy`)
# D1_DATABASE_ID=""
# D1_DATABASE_NAME="sun-nova-db"
# R2_BUCKET_NAME="sun-nova-media"
# Optional: ONNX WASM (~22.81 MiB) is excluded by default for fast CDN deploys; set BUNDLE_ORT_WASM="true" to bundle locally
# BUNDLE_ORT_WASM="false"
