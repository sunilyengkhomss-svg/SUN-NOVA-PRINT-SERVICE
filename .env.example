# GEMINI_API_KEY: Required for Gemini AI Assistant, OCR, and Resume Assist calls.
# AI Studio injects this locally; configure via Cloudflare Secrets for production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Official public URL (configure when your domain is ready)
APP_URL=""
VITE_SITE_URL=""
VITE_BASE_URL="/"

# Optional extra guard for initial /admin setup & password recovery
ADMIN_SETUP_TOKEN=""

# Optional transactional email delivery (https://resend.com) for Admin Mail Desk & Password Reset
RESEND_API_KEY=""
EMAIL_FROM="SUN-NOVA PRINT SERVICE <onboarding@resend.dev>"
