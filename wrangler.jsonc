{
  "name": "sun-nova-print-service",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
  // Bindings are auto-injected during `npm run build` when D1_DATABASE_ID / R2_BUCKET_NAME
  // are set in Cloudflare Workers Build variables, OR populated automatically by `npm run cf:setup`:
  // "d1_databases": [
  //   {
  //     "binding": "SUN",
  //     "database_name": "sun-nova-print-service",
  //     "database_id": "<2ce8587c-3a47-43c1-9a26-0b3f4ecf1>",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA_BUCKET",
  //     "bucket_name": "sun-nova-media"
  //   }
  // ]
}
